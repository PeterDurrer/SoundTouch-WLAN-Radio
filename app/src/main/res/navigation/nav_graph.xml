<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/playerFragment">

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.soundtouchradio.ui.main.PlayerFragment"
        android:label="@string/player_title">
        <action
            android:id="@+id/action_playerFragment_to_senderListFragment"
            app:destination="@id/senderListFragment" />
    </fragment>

    <fragment
        android:id="@+id/senderListFragment"
        android:name="com.soundtouchradio.ui.main.SenderListFragment"
        android:label="@string/sender_list_title">
        <action
            android:id="@+id/action_senderListFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
    </fragment>
</navigation>
